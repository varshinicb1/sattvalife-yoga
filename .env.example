# Application
NEXT_PUBLIC_APP_URL=https://sattvalife.yoga
NEXT_PUBLIC_APP_NAME=Sattvalife Yoga
NODE_ENV=development

# Database (Cloudflare D1 / libsql)
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Session (Iron Session)
SESSION_PASSWORD=sattvalife-yoga-session-password-2024-min-32-chars-long!!

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth (for Calendar)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp Baileys Sidecar Service
WHATSAPP_SERVICE_URL=http://localhost:3001

# NVIDIA NIM (Gemma 4) - Free Tier
NVIDIA_NIM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Sattvalife Yoga <noreply@sattvalife.yoga>

# Encryption
ENCRYPTION_PASSWORD=sattvalife-yoga-encryption-key-2024-min-32-chars!!
ENCRYPTION_SALT=sattvalife-yoga-salt-2024

# Cloudflare
CLOUDFLARE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxx
CLOUDFLARE_R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxx
CLOUDFLARE_R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_R2_BUCKET=sattvalife-assets
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# Analytics
NEXT_PUBLIC_CF_BEACON_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# Sentry (optional)
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxx@o123456.ingest.sentry.io/123456
SENTRY_ORG=your-org
SENTRY_PROJECT=sattvalife-yoga

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_CHAT=true
NEXT_PUBLIC_ENABLE_WHATSAPP=true
NEXT_PUBLIC_ENABLE_GOOGLE_CALENDAR=true
NEXT_PUBLIC_ENABLE_CORPORATE=true