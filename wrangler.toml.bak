name = "sattvalife-yoga"
main = "src/worker.ts"
compatibility_date = "2024-12-01"
compatibility_flags = ["nodejs_compat", "nodejs_compat_populate_global_scope"]

# Build configuration
[build]
command = "pnpm run build"
watch_dir = "src"
cwd = "."

[build.upload]
format = "modules"
dir = ".vercel/output/static"
main = ".vercel/output/static/_worker.js"

# D1 Database
[[d1_databases]]
binding = "DB"
database_name = "sattvalife-yoga"
database_id = ""  # Set after creating database

# R2 Storage
[[r2_buckets]]
binding = "ASSETS"
bucket_name = "sattvalife-assets"

# Queues
[[queues]]
binding = "EMAIL_QUEUE"
queue_name = "email-queue"

[[queues]]
binding = "WHATSAPP_QUEUE"
queue_name = "whatsapp-queue"

[[queues]]
binding = "CALENDAR_QUEUE"
queue_name = "calendar-queue"

# AI Binding (NVIDIA NIM)
[ai]
binding = "AI"

# Environment variables (set via Cloudflare dashboard)
# These are NOT in the wrangler.toml - they must be set in Cloudflare Pages dashboard
# SESSION_PASSWORD
# STRIPE_SECRET_KEY
# STRIPE_PUBLISHABLE_KEY
# STRIPE_WEBHOOK_SECRET
# GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET
# WHATSAPP_ACCESS_TOKEN
# WHATSAPP_PHONE_NUMBER_ID
# WHATSAPP_WABA_ID
# WHATSAPP_VERIFY_TOKEN
# NVIDIA_NIM_API_KEY
# RESEND_API_KEY
# EMAIL_FROM
# ENCRYPTION_PASSWORD
# ENCRYPTION_SALT
# NEXT_PUBLIC_APP_URL
# SENTRY_DSN

# Observability
[observability]
enabled = true

[observability.logs]
enabled = true

[observability.tracing]
enabled = true
sample_rate = 0.1

# Assets
[assets]
directory = "./public"
binding = "ASSETS"
not_found_handling = "single-page-application"
html_handling = "auto-trailing-slash"