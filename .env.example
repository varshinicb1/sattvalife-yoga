# Copy to .env.local (git-ignored). Every variable is optional: the site builds
# and runs without any of them.

# PostHog analytics, loaded only after cookie consent. Must be a *project* key
# (starts with phc_). Never put a personal key (phx_) here: it ships to browsers.
VITE_POSTHOG_KEY=
# Region the PostHog project lives in (US default, or https://eu.i.posthog.com)
VITE_POSTHOG_HOST=https://us.i.posthog.com
