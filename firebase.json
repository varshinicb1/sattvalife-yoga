{
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/shop",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/posture-lab",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/courses",
        "destination": "/classes",
        "type": 301
      },
      {
        "source": "/timetable",
        "destination": "/classes",
        "type": 301
      },
      {
        "source": "/about-us",
        "destination": "/teachers",
        "type": 301
      },
      {
        "source": "/about-us/",
        "destination": "/teachers",
        "type": 301
      },
      {
        "source": "/classes-timetable",
        "destination": "/classes",
        "type": 301
      },
      {
        "source": "/classes-timetable/",
        "destination": "/classes",
        "type": 301
      },
      {
        "source": "/terms-and-conditions",
        "destination": "/terms",
        "type": 301
      },
      {
        "source": "/terms-and-conditions/",
        "destination": "/terms",
        "type": 301
      },
      {
        "source": "/blog-standard",
        "destination": "/blog",
        "type": 301
      },
      {
        "source": "/blog-standard/",
        "destination": "/blog",
        "type": 301
      },
      {
        "source": "/3-quick-yoga-asanas-to-get-relief-from-back-pain",
        "destination": "/blog/3-quick-yoga-asanas-for-back-pain",
        "type": 301
      },
      {
        "source": "/3-quick-yoga-asanas-to-get-relief-from-back-pain/",
        "destination": "/blog/3-quick-yoga-asanas-for-back-pain",
        "type": 301
      },
      {
        "source": "/yoga-and-meditation",
        "destination": "/blog/yoga-and-meditation",
        "type": 301
      },
      {
        "source": "/yoga-and-meditation/",
        "destination": "/blog/yoga-and-meditation",
        "type": 301
      },
      {
        "source": "/conclusion-empowering-children-through-yoga",
        "destination": "/blog/empowering-children-through-yoga",
        "type": 301
      },
      {
        "source": "/conclusion-empowering-children-through-yoga/",
        "destination": "/blog/empowering-children-through-yoga",
        "type": 301
      },
      {
        "source": "/timetable-for-wordpress",
        "destination": "/classes",
        "type": 301
      },
      {
        "source": "/timetable-for-wordpress/",
        "destination": "/classes",
        "type": 301
      },
      {
        "source": "/feed",
        "destination": "/rss.xml",
        "type": 301
      },
      {
        "source": "/feed/",
        "destination": "/rss.xml",
        "type": 301
      },
      {
        "source": "/sitemap_index.xml",
        "destination": "/sitemap.xml",
        "type": 301
      },
      {
        "source": "/post-sitemap.xml",
        "destination": "/sitemap.xml",
        "type": 301
      },
      {
        "source": "/page-sitemap.xml",
        "destination": "/sitemap.xml",
        "type": 301
      },
      {
        "source": "/timetable-for-wordpress-sample-:n",
        "destination": "/classes",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
          }
        ]
      },
      {
        "source": "**/!(*.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|webp|svg|ico|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ]
  }
}
